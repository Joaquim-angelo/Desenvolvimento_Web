Dentro do script no arquivo App.js diversas ferramentas podem ser utilizadas, vemos alguns exemplos a seguir:

01-O uso de variáveis e funções é permita no framework:

function App() {
  var nome = "Joaquim";
  const maiusculo = nome.toUpperCase()
  return (
    <div className="App">
      <h1>React APP</h1>
      <p>Testes de {maiusculo} em React</p>
    </div>
  );
}

02-Exibição de imagens na tela:

function App() {
  const url = 'https://bognarjunior.wordpress.com/wp-content/uploads/2018/03/if_react-js_logo_1174949.png'
  return (
    <div className="App">
      <h1>React APP</h1>
      <img src={url}/>
    </div>
  );
}